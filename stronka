/* =========================================================
   Limonte Cocktail Bar – style
   Układ: desktop → tablet (≤1100px) → telefon (≤760px)
   ========================================================= */

/* ---------- Zmienne ---------- */
:root{
  --bg:#020604; --bg2:#06110b; --panel:rgba(14,24,18,.78); --panel2:rgba(255,255,255,.055);
  --line:rgba(255,255,255,.11); --line-green:rgba(103,255,107,.24); --text:#f4fff2; --muted:#b9c8b7;
  --green:#70ff5f; --green2:#14d873; --deep:#07150d; --gold:#d4aa66; --shadow:0 28px 80px rgba(0,0,0,.42);
  --gutter:44px;
  --header-h:80px;
}

/* ---------- Baza ---------- */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%;overflow-x:hidden;overflow-x:clip}
body{
  margin:0;min-width:320px;overflow-x:hidden;overflow-x:clip;
  background:radial-gradient(circle at 12% 4%,rgba(84,255,103,.14),transparent 26%),linear-gradient(180deg,#020604,#06110b 48%,#020604);
  background-color:#020604;
  color:var(--text);font-family:Manrope,Inter,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.014) 1px,transparent 1px);
  background-size:42px 42px;
  -webkit-mask-image:radial-gradient(circle at center,#000,transparent 86%);
  mask-image:radial-gradient(circle at center,#000,transparent 86%);
}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%;height:auto}
figure{margin:0}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
h1,h2,h3{overflow-wrap:break-word}
a,button,.btn,.gallery-tile,.nav-toggle,input,textarea,select{-webkit-tap-highlight-color:rgba(112,255,95,.25);touch-action:manipulation}
:focus-visible{outline:2px solid var(--green);outline-offset:3px}

.container{width:min(1180px,100% - var(--gutter));margin-inline:auto}
main section[id]{scroll-margin-top:var(--header-h)}

.skip-link{position:absolute;top:-100px;left:10px;background:#fff;color:#000;padding:10px 14px;border-radius:10px;font-weight:800;z-index:200}
.skip-link:focus{top:10px}

/* ---------- Sekcje / typografia ---------- */
.section{position:relative;padding:112px 0;z-index:3}
.section-tight{padding-top:88px}
.section-head{display:grid;grid-template-columns:.95fr 1fr;gap:70px;align-items:end;margin-bottom:48px;text-align:left}
.section-head h2,.section-copy h2{margin:0;font-family:Sora,Manrope,sans-serif;font-weight:700;line-height:1.12;letter-spacing:-.02em;font-size:clamp(32px,4vw,56px);color:#fff;text-shadow:0 2px 20px rgba(0,0,0,.4);text-wrap:balance}
.section-head p,.section-copy p{margin:0;color:var(--muted);font-size:clamp(16px,1.35vw,20px);line-height:1.75}
.section-head .text p{max-width:620px}
.section-copy{text-align:left}
.section-copy h2{margin-bottom:22px}
.section-copy p+p{margin-top:14px}
.section-actions{margin-top:24px;display:flex;flex-wrap:wrap;gap:12px}
.section-cta{display:flex;justify-content:center;margin-top:34px}

.eyebrow{display:inline-flex;align-items:center;gap:9px;padding:8px 14px;border:1px solid var(--line-green);background:rgba(102,255,91,.12);color:#eaffdf;border-radius:999px;font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:800;box-shadow:0 0 28px rgba(99,255,89,.13);margin:0 0 18px}
.eyebrow::before{content:"";width:9px;height:9px;flex:0 0 auto;border-radius:50%;background:var(--green);box-shadow:0 0 16px var(--green)}

/* ---------- Przyciski ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:52px;padding:0 24px;border-radius:999px;font-weight:800;font-size:14px;line-height:1.2;text-align:center;border:0;transition:transform .22s ease,box-shadow .22s ease,background .22s ease,border-color .22s ease,opacity .22s ease}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:linear-gradient(135deg,#93ff6a,#3cf46f);color:#021005;box-shadow:0 18px 42px rgba(91,255,100,.28)}
.btn-primary:hover{box-shadow:0 22px 48px rgba(91,255,100,.38)}
.btn-glass,.btn-ghost{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);color:#fff}
.btn-ghost{background:rgba(0,0,0,.18)}
.btn-glass:hover,.btn-ghost:hover{border-color:rgba(112,255,95,.4)}

/* ---------- Nagłówek / menu ---------- */
.site-header{position:fixed;top:18px;left:0;right:0;z-index:60;pointer-events:none}
.header-shell{
  position:relative;pointer-events:auto;width:min(1140px,100% - 36px);margin:0 auto;min-height:62px;
  padding:10px 12px 10px 18px;border-radius:999px;border:1px solid rgba(255,255,255,.14);
  background:rgba(3,7,5,.72);-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);
  display:flex;align-items:center;gap:18px;box-shadow:0 18px 52px rgba(0,0,0,.26);
}
.brand{display:flex;align-items:center;gap:10px;min-width:220px;flex-shrink:0}
.brand img{width:156px;height:auto}
.brand span{font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:800;color:#c6d4c3;white-space:nowrap}
.main-nav{margin-left:auto;display:flex;align-items:center;gap:18px}
.main-nav a{font-size:13px;font-weight:800;color:#ecf6ea;opacity:.94;white-space:nowrap;transition:color .2s ease}
.main-nav a:hover{color:var(--green)}
.nav-socials{display:flex;gap:8px;flex-shrink:0}
.social-icon{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:#e8f5e6;transition:background .2s ease,border-color .2s ease,color .2s ease}
.social-icon:hover{background:rgba(112,255,95,.18);border-color:rgba(112,255,95,.35);color:var(--green)}
.social-icon svg{display:block}
.nav-toggle{display:none;align-items:center;justify-content:center;gap:9px;min-height:42px;padding:0 16px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.08);color:#fff;border-radius:999px;font-weight:800;font-size:13px;flex-shrink:0}
.nav-toggle-icon{position:relative;width:16px;height:12px;display:block}
.nav-toggle-icon i{position:absolute;left:0;width:100%;height:2px;border-radius:2px;background:currentColor;transition:transform .25s ease,opacity .2s ease,top .25s ease}
.nav-toggle-icon i:nth-child(1){top:0}
.nav-toggle-icon i:nth-child(2){top:5px}
.nav-toggle-icon i:nth-child(3){top:10px}
.nav-toggle[aria-expanded="true"] .nav-toggle-icon i:nth-child(1){top:5px;transform:rotate(45deg)}
.nav-toggle[aria-expanded="true"] .nav-toggle-icon i:nth-child(2){opacity:0}
.nav-toggle[aria-expanded="true"] .nav-toggle-icon i:nth-child(3){top:5px;transform:rotate(-45deg)}

/* ---------- Hero ---------- */
.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:center;overflow:hidden;padding-top:88px}
.hero-bg,.hero-slide,.hero-shade{position:absolute;inset:0;pointer-events:none}
.hero-bg{z-index:0;background:#000;overflow:hidden}
.hero-slide{background-image:var(--bgimg);background-size:cover;background-position:center;opacity:0;transform:scale(1.08);animation:heroLoop 30s infinite ease-in-out;filter:saturate(1.08) contrast(1.03);will-change:opacity,transform}
.hero-slide:nth-child(1){animation-delay:0s}
.hero-slide:nth-child(2){animation-delay:10s}
.hero-slide:nth-child(3){animation-delay:20s}
@keyframes heroLoop{0%{opacity:0;transform:scale(1.06)}8%{opacity:1;transform:scale(1.03)}30%{opacity:1;transform:scale(1.01)}38%{opacity:0;transform:scale(1.05)}100%{opacity:0;transform:scale(1.06)}}
.hero-shade{z-index:1;background:linear-gradient(90deg,rgba(1,5,3,.88) 0%,rgba(1,5,3,.68) 38%,rgba(1,5,3,.38) 60%,rgba(1,5,3,.82) 100%),radial-gradient(circle at 20% 50%,rgba(52,255,87,.16),transparent 36%),linear-gradient(180deg,rgba(1,5,3,.24),rgba(1,5,3,.7))}
.hero-inner{position:relative;z-index:3;min-height:calc(100vh - 96px);min-height:calc(100svh - 96px);display:flex;align-items:center;justify-content:flex-start}
.hero-copy{width:min(650px,100%);margin-left:clamp(0px,3vw,52px);text-align:left}
.hero-logo{width:min(310px,72vw);height:auto;margin-bottom:24px}
.hero-kicker{margin:0 0 14px;color:#bfffb6;font-size:12px;letter-spacing:.24em;text-transform:uppercase;font-weight:800}
.hero h1{margin:0;font-family:Sora,Manrope,sans-serif;font-size:clamp(44px,5.8vw,88px);line-height:1.05;letter-spacing:-.03em;font-weight:700;text-wrap:balance;color:#fff;text-shadow:0 3px 28px rgba(0,0,0,.45)}
.hero-lead{margin:24px 0 0;max-width:540px;color:#edf8eb;font-size:clamp(17px,1.4vw,21px);line-height:1.62}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.hero-contact{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:16px;color:#edf8eb;font-weight:800;font-size:14px}
.hero-contact span{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green)}
.hero-contact a:hover{color:var(--green)}
.scroll-cue{position:absolute;z-index:4;left:50%;bottom:22px;transform:translateX(-50%);display:grid;place-items:center;gap:8px;color:#d9f5d5;text-transform:uppercase;letter-spacing:.16em;font-size:10px;font-weight:800}
.scroll-cue span{width:22px;height:38px;border-radius:999px;border:1px solid rgba(255,255,255,.22);position:relative}
.scroll-cue span::after{content:"";position:absolute;top:8px;left:50%;width:4px;height:4px;border-radius:50%;background:var(--green);transform:translateX(-50%);animation:scrollDot 1.4s infinite}
@keyframes scrollDot{to{top:23px;opacity:0}}

/* ---------- Bąbelki (canvas) ---------- */
#bubbleCanvas{position:fixed;top:0;left:0;width:100%;height:100vh;height:100lvh;z-index:1;pointer-events:none;mix-blend-mode:screen;opacity:.92}

/* ---------- Pasek (marquee) ---------- */
.marquee{position:relative;z-index:5;overflow:hidden;background:rgba(0,0,0,.62);border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);width:100%}
.marquee-track{display:flex;width:max-content;animation:marquee 28s linear infinite}
.marquee-group{display:flex;align-items:center;gap:28px;flex:0 0 auto;padding:18px 28px;white-space:nowrap}
.marquee span{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:800;color:#f3fff2}
.marquee i{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);flex:0 0 auto}
@keyframes marquee{to{transform:translateX(-25%)}}

/* ---------- Doświadczenie ---------- */
.story-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:70px;align-items:center}
.pill-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.pill-list span{padding:10px 13px;border-radius:999px;background:rgba(98,255,90,.09);border:1px solid rgba(98,255,90,.18);font-weight:800;color:#efffee;font-size:13px}
.story-photos{display:grid;grid-template-columns:1.16fr .84fr;grid-template-rows:300px 300px;gap:22px}
.story-photo{position:relative;border-radius:34px;overflow:hidden;border:1px solid rgba(255,255,255,.12);box-shadow:var(--shadow);background:#07100b;min-height:0}
.story-photo.big{grid-row:1/3}
.story-photo img{width:100%;height:100%;object-fit:cover;object-position:center}
.story-photo .label{position:absolute;left:12px;bottom:12px;right:12px;padding:11px 14px;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(0,0,0,.58));-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);font-size:clamp(13px,1.4vw,17px);font-weight:800;line-height:1.2}

/* ---------- Bary ---------- */
.bars-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.bar-card{border-radius:38px;overflow:hidden;border:1px solid rgba(255,255,255,.12);background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.026));box-shadow:var(--shadow);display:flex;flex-direction:column}
.bar-media{aspect-ratio:3/2;overflow:hidden;background:#07100b}
.bar-media img{width:100%;height:100%;object-fit:cover;object-position:center}
.bar-body{padding:28px}
.bar-number{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:rgba(112,255,95,.13);border:1px solid rgba(112,255,95,.24);color:#efffee;font-weight:800;margin-bottom:18px}
.bar-body h3{font-family:Sora,Manrope,sans-serif;font-size:24px;margin:0 0 12px;letter-spacing:-.015em;line-height:1.25;font-weight:700}
.bar-body p{color:var(--muted);line-height:1.7;margin:0}
.bar-body ul{display:grid;gap:9px;margin:18px 0 0;padding:0;list-style:none;color:#eef8ec}
.bar-body li::before{content:"✦";color:var(--green);margin-right:10px}

/* ---------- Oferta ---------- */
.offer-wrap{max-width:1100px;margin-inline:auto}
.base-package{border-radius:38px;border:1px solid rgba(112,255,95,.25);background:linear-gradient(135deg,rgba(112,255,95,.13),rgba(255,255,255,.045));box-shadow:var(--shadow);padding:38px;margin-bottom:24px}
.base-package h3{font-family:Sora,Manrope,sans-serif;font-size:clamp(26px,3.2vw,44px);line-height:1.15;letter-spacing:-.02em;margin:0 0 16px;font-weight:700}
.base-package p{color:var(--muted);line-height:1.75;font-size:17px}
.base-features{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:22px}
.base-features span{padding:12px 14px;border-radius:16px;background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.08);font-weight:800}
.base-features span::before{content:"";display:inline-block;width:8px;height:8px;background:var(--green);box-shadow:0 0 12px var(--green);border-radius:50%;margin-right:9px;vertical-align:middle}
.addon-list{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.addon-card{display:flex;flex-direction:column;justify-content:flex-end;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:#07100b;box-shadow:0 18px 50px rgba(0,0,0,.3);overflow:hidden;position:relative;min-height:340px}
.addon-media{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.addon-media img{width:100%;height:100%;object-fit:cover;object-position:center}
.addon-text{position:relative;z-index:2;margin-top:auto;padding:22px 18px 20px;background:linear-gradient(to top,rgba(0,0,0,.9) 0%,rgba(0,0,0,.62) 58%,transparent 100%)}
.addon-text .eyebrow{color:var(--green);background:rgba(0,0,0,.45)}
.addon-text h3{font-family:Sora,Manrope,sans-serif;font-size:clamp(17px,1.8vw,23px);line-height:1.25;letter-spacing:-.01em;margin:0 0 8px;font-weight:700;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.5)}
.addon-text p{color:#d8e8d6;line-height:1.65;font-size:14px;margin:0}
.addon-text ul{margin:14px 0 0;padding:0;list-style:none;display:grid;gap:6px}
.addon-text li{color:#d8e8d6;font-size:14px}
.addon-text li::before{content:"+";color:var(--green);font-weight:800;margin-right:10px}

/* ---------- Barmani ---------- */
.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.team-card{border:1px solid rgba(255,255,255,.12);border-radius:38px;background:linear-gradient(180deg,rgba(255,255,255,.065),rgba(255,255,255,.025));box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column}
.team-media{height:520px;overflow:hidden;background:#07100b}
.team-media img{width:100%;height:100%;object-fit:cover;object-position:center top}
.team-body{padding:28px}
.team-body span{display:block;color:var(--green);font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:800;margin-bottom:10px}
.team-body h3{font-family:Sora,Manrope,sans-serif;font-size:22px;line-height:1.25;margin:0 0 12px;letter-spacing:-.015em;font-weight:700}
.team-body p{color:var(--muted);line-height:1.72;margin:0}

/* ---------- Menu ---------- */
.menu-layout{display:grid;grid-template-columns:.88fr 1.12fr;gap:30px;align-items:stretch}
.menu-segments{display:grid;gap:20px}
.segment-card{position:relative;min-height:220px;border:1px solid rgba(255,255,255,.12);border-radius:30px;overflow:hidden;box-shadow:var(--shadow);background:#08110b}
.segment-card img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.segment-card::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72),rgba(0,0,0,.18)),linear-gradient(0deg,rgba(0,0,0,.70),transparent 48%)}
.segment-text{position:relative;z-index:2;padding:28px;display:flex;flex-direction:column;justify-content:flex-end;min-height:220px;height:100%}
.segment-text h3{font-family:Sora,Manrope,sans-serif;font-size:24px;letter-spacing:-.015em;margin:0 0 10px;line-height:1.25;font-weight:700}
.segment-text p{color:#edf8eb;line-height:1.6;margin:0}
.menu-board{border:1px solid rgba(255,255,255,.12);border-radius:34px;background:rgba(255,255,255,.045);padding:18px;box-shadow:var(--shadow);display:flex;align-items:center;justify-content:center}
.menu-board img{width:100%;height:100%;max-height:870px;object-fit:contain;border-radius:24px;background:#000}
.classics-panel{margin-top:24px;display:grid;grid-template-columns:330px 1fr;gap:24px;align-items:center;border:1px solid rgba(112,255,95,.18);border-radius:34px;background:linear-gradient(135deg,rgba(112,255,95,.09),rgba(255,255,255,.04));padding:22px;box-shadow:var(--shadow)}
.classics-panel img{width:100%;height:230px;object-fit:cover;border-radius:24px}
.classics-panel h3{font-family:Sora,Manrope,sans-serif;font-size:clamp(19px,1.8vw,24px);line-height:1.3;font-weight:700;margin:0 0 16px;letter-spacing:-.01em}
.classic-list{display:flex;flex-wrap:wrap;gap:10px}
.classic-list span{padding:10px 13px;border-radius:999px;background:rgba(0,0,0,.24);border:1px solid rgba(112,255,95,.22);font-weight:800;color:#efffee;font-size:13px}

/* ---------- Opinie ---------- */
.reviews-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:36px;align-items:center}
.reviews-box{border-radius:28px;border:1px solid rgba(255,255,255,.12);background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(112,255,95,.06));box-shadow:var(--shadow);padding:28px 24px;overflow:hidden}
.cert-row{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:center;margin-bottom:8px}
.cert-badge{display:block;transition:transform .2s}
.cert-badge:hover{transform:translateY(-2px)}
.cert-laurel{width:160px;height:160px;border-radius:50%;background:radial-gradient(circle at 50% 40%,#fff 0%,#f8f0ff 70%);border:3px solid #6b2d8b;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 8px 28px rgba(107,45,139,.25);text-align:center;padding:12px}
.cert-title{font-size:12px;font-weight:800;color:#7a1f6b;letter-spacing:.06em;text-transform:uppercase}
.cert-sub{font-size:13px;font-weight:800;color:#5a1a7a;margin-top:2px}
.cert-stars{color:#d4aa00;font-size:14px;margin-top:6px;letter-spacing:2px}
.cert-link{font-size:11px;color:#6b2d8b;margin-top:6px;font-weight:700}
.wzk-banner{display:inline-flex;align-items:center;justify-content:center;background:#7a1f6b;color:#fff;padding:14px 28px;border-radius:8px;font-weight:800;font-size:15px;letter-spacing:.06em;box-shadow:0 8px 24px rgba(122,31,107,.3);transition:transform .2s}
.wzk-banner:hover{transform:translateY(-2px)}
.reviews-more{text-align:center;margin:16px 0 0;font-size:14px}
.reviews-more a{color:var(--green);font-weight:800;text-decoration:underline;text-underline-offset:3px}

/* ---------- Galeria ---------- */
.gallery-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.gallery-tile{position:relative;z-index:2;display:block;width:100%;padding:0;aspect-ratio:4/3;border-radius:22px;overflow:hidden;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);cursor:zoom-in;box-shadow:0 16px 42px rgba(0,0,0,.28)}
.gallery-tile img{width:100%;height:100%;object-fit:cover;transition:transform .42s ease,filter .42s ease}
.gallery-tile:hover img{transform:scale(1.055);filter:saturate(1.08)}

/* ---------- Kontakt + formularz ---------- */
.contact-banner{
  border-radius:40px;border:1px solid rgba(112,255,95,.25);
  background:radial-gradient(circle at 18% 0%,rgba(112,255,95,.18),transparent 34%),linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.028));
  box-shadow:var(--shadow);padding:44px;
  display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
  grid-template-areas:"intro form" "links form";grid-template-rows:auto 1fr;gap:30px 44px;align-items:start;
}
.contact-intro{grid-area:intro}
.contact-intro p{margin:0;color:var(--muted);font-size:clamp(16px,1.3vw,18px);line-height:1.7}
.contact-banner h2{font-family:Sora,Manrope,sans-serif;font-size:clamp(30px,3.8vw,52px);line-height:1.15;letter-spacing:-.02em;margin:0 0 16px;font-weight:700;text-wrap:balance}
.contact-logo{width:min(200px,60%);height:auto;margin-bottom:18px}
.contact-links{grid-area:links;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.contact-links .contact-pill:last-child{grid-column:1/-1}
.contact-pill{min-height:56px;padding:16px 18px;border-radius:22px;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.1);display:grid;gap:4px;align-content:center;transition:border-color .2s ease,background .2s ease}
.contact-pill:hover{border-color:rgba(112,255,95,.35);background:rgba(112,255,95,.06)}
.contact-pill strong{font-size:12px;color:var(--green);text-transform:uppercase;letter-spacing:.12em}
.contact-pill span{font-weight:800;overflow-wrap:anywhere}

.reserve-form{grid-area:form;display:grid;gap:14px;padding:28px;border-radius:30px;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.1)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{display:grid;gap:7px;min-width:0}
.field label{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#d5e6d2}
.field label b{color:var(--green)}
.reserve-form input,.reserve-form textarea{
  width:100%;min-height:50px;padding:13px 16px;border-radius:14px;border:1px solid rgba(255,255,255,.16);
  background:rgba(0,0,0,.32);color:#f4fff2;font-size:16px;font-weight:600;line-height:1.4;
  outline:none;transition:border-color .2s ease,box-shadow .2s ease;-webkit-appearance:none;appearance:none;
}
.reserve-form input::placeholder,.reserve-form textarea::placeholder{color:#7f917d;opacity:1}
.reserve-form input:focus,.reserve-form textarea:focus{border-color:rgba(112,255,95,.6);box-shadow:0 0 0 3px rgba(112,255,95,.14)}
.reserve-form textarea{resize:vertical;min-height:110px}
.reserve-form input[type=number]{-moz-appearance:textfield}
.reserve-form input[type=number]::-webkit-outer-spin-button,.reserve-form input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.reserve-form.was-validated input:invalid,.reserve-form.was-validated textarea:invalid{border-color:rgba(255,107,107,.75)}
.hp{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;border:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;opacity:0;pointer-events:none}
.btn-submit{width:100%;margin-top:4px;font-size:15px}
.btn-submit:disabled{opacity:.75;cursor:progress;transform:none}
.btn-spinner{display:none;width:18px;height:18px;border-radius:50%;border:2px solid rgba(2,16,5,.3);border-top-color:#021005;animation:spin .8s linear infinite}
.btn-submit.is-loading .btn-spinner{display:inline-block}
@keyframes spin{to{transform:rotate(360deg)}}
.form-note{margin:0;font-size:13px;line-height:1.55;color:#93a591}
.form-note b{color:var(--green)}
.form-status{padding:16px 18px;border-radius:16px;font-size:15px;line-height:1.6;font-weight:600}
.form-status[hidden]{display:none}
.form-status.is-success{background:rgba(112,255,95,.12);border:1px solid rgba(112,255,95,.4);color:#eaffdf}
.form-status.is-error{background:rgba(255,90,90,.1);border:1px solid rgba(255,120,120,.45);color:#ffe3e3}
.form-status strong{display:block;font-size:16px;margin-bottom:2px}
.form-status a{color:var(--green);font-weight:800;text-decoration:underline;text-underline-offset:3px}

/* ---------- Stopka ---------- */
.footer{position:relative;z-index:2;padding:34px 0 26px;border-top:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.28)}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}
.footer-logo img{width:190px;height:auto}
.footer-links{display:flex;gap:10px 18px;flex-wrap:wrap;font-weight:800}
.footer-links a:hover{color:var(--green)}
.footer-copy{margin-top:18px;font-size:13px;color:#8fa08d}

/* ---------- Pływające przyciski ---------- */
.floating-cta{position:fixed;right:18px;bottom:18px;bottom:calc(18px + env(safe-area-inset-bottom));z-index:40;display:grid;gap:10px;transition:opacity .3s ease,transform .3s ease}
.js .floating-cta{opacity:0;transform:translateY(14px);pointer-events:none}
.js .floating-cta.is-shown{opacity:1;transform:none;pointer-events:auto}
.floating-cta a{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:rgba(112,255,95,.95);color:#021005;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.floating-cta a:nth-child(2){background:rgba(10,18,12,.72);border:1px solid rgba(255,255,255,.18);color:#fff;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.floating-cta a:hover{transform:translateY(-2px)}

/* ---------- Lightbox ---------- */
.lightbox{position:fixed;inset:0;width:100%;height:100%;max-width:100%;max-height:100%;margin:0;padding:0;border:none;background:rgba(0,0,0,.94);color:#fff;align-items:center;justify-content:center;z-index:9999;overscroll-behavior:contain}
.lightbox[open]{display:flex}
.lightbox::backdrop{background:rgba(0,0,0,.9)}
.lightbox img{max-width:min(90vw,1100px);max-height:85vh;max-height:85dvh;width:auto;height:auto;object-fit:contain;border-radius:10px;box-shadow:0 20px 60px rgba(0,0,0,.5);position:relative;z-index:1;user-select:none;-webkit-user-select:none}
.lightbox-close,.lightbox-prev,.lightbox-next{position:absolute;z-index:10;display:flex;align-items:center;justify-content:center;border:0;border-radius:50%;background:rgba(255,255,255,.15);color:#fff;line-height:1;transition:background .2s ease}
.lightbox-close{top:16px;right:20px;top:calc(16px + env(safe-area-inset-top));width:48px;height:48px;font-size:28px}
.lightbox-prev,.lightbox-next{top:50%;transform:translateY(-50%);width:50px;height:50px;font-size:30px}
.lightbox-prev{left:16px}
.lightbox-next{right:16px}
.lightbox-prev:hover,.lightbox-next:hover,.lightbox-close:hover{background:rgba(112,255,95,.4)}
.lightbox-count{position:absolute;left:50%;bottom:18px;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%);margin:0;padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.1);font-size:13px;font-weight:800;letter-spacing:.08em;z-index:10}
html.lb-open,html.lb-open body{overflow:hidden}

@keyframes menuIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

/* ---------- Animacja pojawiania ---------- */
.js .reveal{opacity:0;transform:translateY(22px);transition:opacity .75s ease,transform .75s ease}
.js .reveal.visible{opacity:1;transform:none}

/* =========================================================
   Szeroki laptop (≤1240px) – ciaśniejsze menu
   ========================================================= */
@media (max-width:1240px){
  .brand{min-width:0}
  .main-nav{gap:15px}
}

/* =========================================================
   Tablet (≤1100px)
   ========================================================= */
@media (max-width:1100px){
  .header-shell{width:min(960px,100% - 28px);gap:12px}
  .brand img{width:138px}
  .brand span{display:none}
  .nav-toggle{display:inline-flex}
  .nav-socials{margin-left:auto}
  .main-nav{
    position:absolute;top:calc(100% + 10px);right:0;left:auto;width:min(340px,100%);margin:0;
    display:none;grid-template-columns:1fr;gap:2px;padding:12px;
    background:#040a06;border:1px solid rgba(255,255,255,.14);border-radius:24px;
    box-shadow:0 24px 60px rgba(0,0,0,.5);max-height:calc(100vh - 110px);max-height:calc(100dvh - 110px);overflow-y:auto;
  }
  .main-nav.open{display:grid;animation:menuIn .22s ease}
  .main-nav a{display:flex;align-items:center;min-height:48px;padding:10px 14px;border-radius:14px;font-size:16px}
  .main-nav a:hover,.main-nav a:focus-visible{background:rgba(112,255,95,.08)}

  .section{padding:96px 0}
  .section-head{gap:40px;margin-bottom:40px}
  .story-grid{gap:40px}
  .hero-copy{margin-left:0}
  .hero h1{max-width:660px}

  .story-photos{grid-template-rows:260px 260px;gap:16px}

  .bars-grid{grid-template-columns:1fr;gap:20px}
  .bar-card{flex-direction:row;border-radius:32px}
  .bar-media{flex:0 0 46%;aspect-ratio:auto;min-height:260px}
  .bar-body{flex:1;display:flex;flex-direction:column;justify-content:center}

  .offer-wrap{max-width:none}

  .team-grid{grid-template-columns:1fr;gap:20px}
  .team-card{flex-direction:row;border-radius:32px}
  .team-media{flex:0 0 40%;height:auto;min-height:380px}
  .team-body{flex:1;display:flex;flex-direction:column;justify-content:center}

  .menu-layout{gap:20px}
  .menu-segments{gap:16px}
  .classics-panel{grid-template-columns:260px 1fr}
  .classics-panel img{height:210px}

  .gallery-grid{grid-template-columns:repeat(4,1fr);gap:14px}

  .contact-banner{padding:36px;gap:28px 32px}
}

/* =========================================================
   Mniejszy tablet (≤900px)
   ========================================================= */
@media (max-width:900px){
  .section-head,.story-grid,.reviews-grid{grid-template-columns:1fr;gap:24px}
  .section-head h2,.section-copy h2{font-size:clamp(32px,5vw,44px)}
  .footer-inner{flex-direction:column;align-items:flex-start;gap:18px}
  .addon-list{grid-template-columns:1fr}
  .addon-card{min-height:320px}
  .contact-banner{grid-template-columns:1fr;grid-template-areas:"intro" "form" "links";grid-template-rows:auto}
}

/* =========================================================
   Telefon (≤760px)
   ========================================================= */
@media (max-width:760px){
  :root{--gutter:28px;--header-h:76px}
  .site-header{top:10px;top:calc(10px + env(safe-area-inset-top))}
  .header-shell{width:calc(100% - 20px);min-height:56px;padding:7px 8px 7px 16px;gap:8px}
  .brand img{width:124px}
  .nav-socials{gap:6px}
  .social-icon{width:36px;height:36px}
  .nav-toggle{min-height:40px;padding:0 14px}
  .main-nav{left:0;width:auto}

  .section{padding:72px 0}
  .section-tight{padding-top:64px}
  .section-head{gap:16px;margin-bottom:30px}
  .section-head h2,.section-copy h2{font-size:clamp(29px,8.4vw,40px);line-height:1.14}
  .section-head p,.section-copy p{font-size:16px;line-height:1.7}
  .section-copy h2{margin-bottom:16px}
  .section-cta{margin-top:28px}
  .section-cta .btn,.section-actions .btn{width:100%;max-width:360px}
  .eyebrow{font-size:11px;padding:7px 12px;margin-bottom:14px}

  /* Hero */
  .hero{padding-top:84px;padding-bottom:36px;align-items:stretch}
  .hero-shade{background:linear-gradient(180deg,rgba(1,5,3,.62) 0%,rgba(1,5,3,.66) 40%,rgba(1,5,3,.86) 100%),radial-gradient(circle at 20% 45%,rgba(52,255,87,.14),transparent 50%)}
  .hero-inner{min-height:calc(100vh - 120px);min-height:calc(100svh - 120px)}
  .hero-logo{width:180px;margin-bottom:18px}
  .hero-kicker{font-size:11px;letter-spacing:.2em;margin-bottom:12px}
  .hero h1{font-size:clamp(36px,10.6vw,52px);line-height:1.06}
  .hero-lead{margin-top:18px;font-size:16px;line-height:1.6}
  .hero-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:26px}
  .hero-actions .btn{width:100%;min-height:50px;padding:0 12px;font-size:14px}
  .hero-actions .btn-primary{grid-column:1/-1;min-height:54px;font-size:15px}
  .hero-contact{font-size:13px;gap:10px 12px;margin-top:18px}
  .scroll-cue{display:none}

  .marquee-group{gap:20px;padding:14px 20px}
  .marquee span{font-size:10px}

  /* Doświadczenie */
  .pill-list{gap:8px;margin-top:20px}
  .pill-list span{padding:9px 12px;font-size:12.5px}
  .story-photos{grid-template-columns:1fr 1fr;grid-template-rows:auto;gap:12px}
  .story-photo{border-radius:24px;aspect-ratio:1/1}
  .story-photo.big{grid-row:auto;grid-column:1/-1;aspect-ratio:4/3}
  .story-photo .label{left:8px;right:8px;bottom:8px;padding:9px 11px;border-radius:12px;font-size:13px}

  /* Bary */
  .bars-grid{gap:18px}
  .bar-card{border-radius:28px}
  .bar-media{min-height:230px}
  .bar-body{padding:22px 22px 24px}
  .bar-number{width:38px;height:38px;margin-bottom:14px}
  .bar-body h3{font-size:22px}

  /* Oferta */
  .base-package{padding:24px;border-radius:28px;margin-bottom:16px}
  .base-package h3{font-size:clamp(24px,7vw,30px)}
  .base-package p{font-size:16px;line-height:1.7;margin:0}
  .base-features{grid-template-columns:1fr;gap:8px;margin-top:18px}
  .base-features span{padding:11px 14px;font-size:14.5px}
  .addon-list{gap:14px}
  .addon-card{min-height:0;border-radius:24px}
  .addon-card::before{content:"";display:block;height:170px}
  .addon-text{padding:22px 20px 22px;background:linear-gradient(to top,rgba(0,0,0,.94) 0%,rgba(0,0,0,.8) 62%,rgba(0,0,0,.2) 100%)}
  .addon-text h3{font-size:20px}

  /* Barmani */
  .team-grid{gap:18px}
  .team-card{border-radius:28px}
  .team-media{min-height:340px}
  .team-body{padding:22px 22px 24px}
  .team-body h3{font-size:21px}

  /* Menu */
  .menu-layout{grid-template-columns:1fr;gap:16px}
  .menu-segments{gap:14px}
  .segment-card,.segment-text{min-height:200px}
  .segment-card{border-radius:24px}
  .segment-text{padding:22px}
  .segment-text h3{font-size:21px}
  .menu-board{padding:10px;border-radius:26px}
  .menu-board img{max-height:none;border-radius:18px}
  .classics-panel{grid-template-columns:1fr;padding:14px 14px 20px;gap:18px;border-radius:26px}
  .classics-panel img{height:auto;aspect-ratio:16/10;border-radius:18px}
  .classics-panel > div{padding:0 6px}
  .classic-list{gap:8px}
  .classic-list span{padding:9px 12px;font-size:12.5px}

  /* Opinie */
  .reviews-box{padding:26px 18px}
  .cert-row{flex-direction:column}
  .cert-laurel{width:140px;height:140px}

  /* Galeria */
  .gallery-grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .gallery-tile{border-radius:16px}

  /* Kontakt */
  .contact-banner{padding:24px 16px;border-radius:30px;gap:22px}
  .contact-intro{padding:0 6px}
  .contact-logo{width:170px;margin-bottom:16px}
  .contact-banner h2{font-size:clamp(29px,8.4vw,40px)}
  .reserve-form{padding:18px 14px;border-radius:22px;gap:12px}
  .form-row{gap:12px}
  .contact-links{gap:10px}
